  "handshakes": {
    "M": {
      "accept": "!reset && (cmd_valid && cmd_ready)",
      "complete": "!reset && (rsp_valid && rsp_ready)",
      "outputs": [
        "rsp_data",
        "rsp_error",
        "rsp_saturated"
      ],
      "ordering": "one command response outstanding; no native task tag",
      "contexts": "one complete-result context; operand bank0/1 are not two independent result contexts",
      "busy_warning": "busy is !cmd_ready; never use busy falling as completion or context release"
    },
    "G": {
      "accept": "!reset && (in_valid && in_ready per two-S16 packet)",
      "complete": "!reset && (out_valid && out_ready per matching packet; finite service completion additionally needs count/drain/store contract)",
      "outputs": [
        "out_data",
        "out_error",
        "out_saturated"
      ],
      "ordering": "in-order four-stage globally stalled stream; no cmd_op/done/busy",
      "hold": "all stages freeze when out_valid && !out_ready"
    },
    "localS": {
      "accept": "!reset && (req_valid[client] && req_ready[client] reserves arbiter command)",
      "complete": "!reset && (rsp_valid[owner] && rsp_ready[owner] after real storage response)",
      "outputs": [
        "rsp_data"
      ],
      "ordering": "one ordinary transaction for the entire private S; owner held",
      "busy_warning": "busy can be zero while feeder done_valid remains unconsumed"
    },
    "feeder": {
      "accept": "!reset && (load_valid && load_ready)",
      "complete": "!reset && (done_valid && done_take; done_error must be sampled)",
      "outputs": [
        "done_error"
      ],
      "ordering": "one finite command; two 512-bit A queue entries and one B entry; one read outstanding",
      "context_effect": "only operand A/B loading, not M computation or result completion"
    }
  }
}
