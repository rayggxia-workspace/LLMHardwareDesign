  "S": {
    "request": "valid/ready snapshots write/address/data; NOT a store ACK",
    "response": "owner-only valid/ready, actual RAM result; write result equals stored data",
    "reset": "synchronous high clears owners/responses/feeder, payload retained; objects invalid until reload and new task"
  },
  "DMA": {
    "address_bits": 40,
    "words_bits": 11,
    "tag_bits": 16,
    "identity": [
      "block8",
      "job32",
      "epoch32",
      "task_sequence32",
      "service_sequence32",
      "token3",
      "kind2"
