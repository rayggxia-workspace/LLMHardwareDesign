    "error": "2 invalid descriptor; 3 external error; sticky protocol_error requires cohort reset; committed writes not rolled back"
  },
  "reset": {
    "members": [
      "MC",
      "LC0",
      "LC1",
      "adapters",
      "S arbiters and feeders",
      "DMA",
      "request and response CDC FIFOs",
      "external responder queues"
    ],
    "provider_ack": "trusted full flush/reset plus quiet; no timeout may manufacture ACK",
    "readmission": "all members ACK, full write/readback/VERIFY/PREPARE, new generation and epoch; old response cannot enter new context"
  },
  "phases": [
