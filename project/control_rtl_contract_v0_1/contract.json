{
  "schema": "local-control-rtl-boundary/0.1",
  "status": "research freeze candidate; no functional controller RTL or compiler/physical qualification",
  "block_parameter": {
    "name": "BLOCK_ID",
    "bits": 8,
    "first_value": 0
  },
  "clock": {
    "sampling": "all values before rising edge; accepted effects visible next cycle",
    "domains": 1,
    "cdc_implemented": false
  },
  "groups": [
    {
      "name": "clock",
      "description": "Single clock. Reset assertion clears local admission, never certifies providers.",
      "pins": [
        {
          "name": "clk_i",
          "width": 1,
          "direction": "input",
          "meaning": "rising-edge clock"
        },
        {
          "name": "rst_ni",
          "width": 1,
          "direction": "input",
          "meaning": "active-low local reset; synchronous observation after deassertion"
        }
      ]
    },
    {
      "name": "cohort",
      "description": "Authority is the external coordinator, not this local controller.",
      "pins": [
        {
          "name": "release_valid_i",
          "width": 1,
          "direction": "input",
          "meaning": "fresh provider/transport reset certificate"
        },
        {
          "name": "release_sequence_i",
          "width": 32,
          "direction": "input",
          "meaning": "coordinator monotonic reset sequence; no wrap"
        },
        {
          "name": "release_epoch_i",
          "width": 32,
          "direction": "input",
          "meaning": "lowest permitted job epoch"
        },
        {
          "name": "deploy_valid_i",
          "width": 1,
          "direction": "input",
          "meaning": "all cohort targets prepared and bundle checked"
        },
        {
          "name": "deploy_generation_i",
          "width": 32,
          "direction": "input",
          "meaning": "same deployment generation as local image"
        },
        {
          "name": "release_ready_o",
          "width": 1,
          "direction": "output",
          "meaning": "accept certificate only in RESET_WAIT"
        },
        {
          "name": "poison_o",
          "width": 1,
          "direction": "output",
          "meaning": "sticky request for coordinated reset"
        },
        {
          "name": "image_valid_o",
          "width": 1,
          "direction": "output",
          "meaning": "local prepared plus matching cohort deployment"
        }
      ]
    },
    {
      "name": "config",
      "description": "Local config API only; physical MMIO/transport remains external.",
      "pins": [
        {
          "name": "cfg_req_valid_i",
          "width": 1,
          "direction": "input",
          "meaning": "one request"
        },
        {
          "name": "cfg_req_op_i",
          "width": 3,
          "direction": "input",
          "meaning": "BEGIN0 WRITE16=1 READ16=2 VERIFY_PASS3 PREPARE4 ABORT5"
        },
        {
          "name": "cfg_req_generation_i",
          "width": 32,
          "direction": "input",
          "meaning": "new on BEGIN, matching afterwards"
        },
        {
          "name": "cfg_req_address_i",
          "width": 14,
          "direction": "input",
          "meaning": "byte address; 16B aligned"
        },
        {
          "name": "cfg_req_data_i",
          "width": 128,
          "direction": "input",
          "meaning": "16 bytes; little endian"
        },
        {
          "name": "cfg_req_total_bytes_i",
          "width": 16,
          "direction": "input",
          "meaning": "BEGIN complete image length, <=8320"
        },
        {
          "name": "cfg_req_image_id_i",
          "width": 32,
          "direction": "input",
          "meaning": "BEGIN program_image_id"
        },
        {
          "name": "cfg_req_topology_id_i",
          "width": 32,
          "direction": "input",
          "meaning": "BEGIN topology_id"
        },
        {
          "name": "cfg_req_abi_id_i",
          "width": 32,
          "direction": "input",
          "meaning": "BEGIN native ABI"
        },
        {
          "name": "cfg_req_capacity_id_i",
          "width": 32,
          "direction": "input",
          "meaning": "BEGIN capacity profile"
        },
        {
          "name": "cfg_req_proof_i",
          "width": 1,
          "direction": "input",
          "meaning": "trusted loader full digest/static checks passed; VERIFY_PASS only"
        },
        {
          "name": "cfg_rsp_ready_i",
          "width": 1,
          "direction": "input",
          "meaning": "host consumed complete response"
        },
        {
          "name": "cfg_req_ready_o",
          "width": 1,
          "direction": "output",
          "meaning": "one transaction at a time; no active task"
        },
        {
          "name": "cfg_rsp_valid_o",
          "width": 1,
          "direction": "output",
          "meaning": "held response, after memory ACK when needed"
        },
        {
          "name": "cfg_rsp_status_o",
          "width": 16,
          "direction": "output",
          "meaning": "existing ISA status codes"
        },
        {
          "name": "cfg_rsp_data_o",
          "width": 128,
          "direction": "output",
          "meaning": "READ16 bytes, otherwise zero"
        },
        {
          "name": "cfg_rsp_generation_o",
          "width": 32,
          "direction": "output",
          "meaning": "echo accepted request generation"
        }
      ]
    },
    {
      "name": "program_memory",
      "description": "One 128-bit 1RW port; wrapper technology is not frozen.",
      "pins": [
        {
          "name": "pm_req_ready_i",
          "width": 1,
          "direction": "input",
          "meaning": "request accepted"
        },
        {
          "name": "pm_rsp_valid_i",
          "width": 1,
          "direction": "input",
          "meaning": "actual read/write completion, >=1 edge later"
        },
        {
          "name": "pm_rsp_data_i",
          "width": 128,
          "direction": "input",
          "meaning": "read word"
        },
        {
          "name": "pm_rsp_error_i",
          "width": 1,
          "direction": "input",
          "meaning": "memory error"
        },
        {
          "name": "pm_req_valid_o",
          "width": 1,
          "direction": "output",
          "meaning": "one held request"
        },
        {
          "name": "pm_req_write_o",
          "width": 1,
          "direction": "output",
          "meaning": "write only while loading"
        },
        {
          "name": "pm_req_address_o",
          "width": 14,
          "direction": "output",
          "meaning": "byte address, aligned16"
        },
        {
          "name": "pm_req_data_o",
          "width": 128,
          "direction": "output",
          "meaning": "write data"
        },
        {
          "name": "pm_rsp_ready_o",
          "width": 1,
          "direction": "output",
          "meaning": "consume or quarantine response"
        }
      ]
    },
    {
      "name": "task",
