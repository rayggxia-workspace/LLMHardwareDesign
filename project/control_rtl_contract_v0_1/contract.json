      "guard": "CALL whole-packet admission and terminal credit reserved"
    },
    {
      "from": "TASK_REQ",
      "to": "TASK_WAIT",
      "guard": "one task-descriptor memory request accepted"
    },
    {
      "from": "TASK_WAIT",
      "to": "TASK_REQ",
