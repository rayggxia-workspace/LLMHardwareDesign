          "width": 3,
          "direction": "input",
          "meaning": "local token"
        },
        {
          "name": "svc_rsp_sequence_i",
          "width": 32,
          "direction": "input",
          "meaning": "service sequence"
        },
        {
          "name": "svc_rsp_job_i",
