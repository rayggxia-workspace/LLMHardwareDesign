{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-hardware-design:precision-capture:1",
  "title": "LLM precision capture v1 (candidate)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "model", "run", "tensors"],
  "properties": {
    "schema": {"const": "llm-precision-capture/1"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["code_commit", "source_dirty", "source_sha256", "script", "arguments", "tool_versions", "hardware"],
      "properties": {
        "code_commit": {"$ref": "#/$defs/gitsha"}, "source_dirty": {"type": "boolean"},
        "source_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha"}},
        "script": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "tool_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "hardware": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "revision", "config_sha256", "weights_manifest_sha256", "tokenizer_manifest_sha256"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha"}, "weights_manifest_sha256": {"$ref": "#/$defs/sha"},
        "tokenizer_manifest_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "batch", "prefix_tokens", "new_tokens", "input_ids_sha256", "data_version", "calibration_split", "evaluation_split", "execution", "backend", "floating_fallbacks", "measurement_scope"],
      "properties": {
        "phase": {"enum": ["prefill", "decode", "operator"]}, "batch": {"type": "integer", "minimum": 1},
        "prefix_tokens": {"type": "integer", "minimum": 0}, "new_tokens": {"type": "integer", "minimum": 1},
        "input_ids_sha256": {"$ref": "#/$defs/sha"}, "data_version": {"type": "string", "minLength": 1},
        "calibration_split": {"type": "string", "minLength": 1}, "evaluation_split": {"type": "string", "minLength": 1},
        "execution": {"enum": ["floating_reference", "fake_quant", "integer_reference", "integer_kernel", "mixed"]},
        "backend": {"type": "string", "minLength": 1}, "floating_fallbacks": {"type": "array", "items": {"type": "string"}},
        "measurement_scope": {"enum": ["numerical_only", "kernel", "full_model"]}
      }
    },
    "tensors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tensor"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitsha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tensor": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "role", "layer", "node", "shape", "axis_names", "dtype", "byte_order", "order", "file", "encoding"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"enum": ["activation", "weight", "accumulator", "output", "reference_output", "kv_key", "kv_value", "recurrent_state", "conv_state", "probability", "scale", "requant_multiplier", "requant_shift", "dyadic_exponent", "token_ids", "mask"]},
        "layer": {"type": "integer", "minimum": -1}, "node": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "axis_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dtype": {"enum": ["f32", "f16", "i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64"]},
        "byte_order": {"const": "little"}, "order": {"const": "C"},
        "file": {
          "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}
        },
        "encoding": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "contract", "parameter_generation", "rounding", "saturation"],
          "properties": {
            "kind": {"enum": ["reference_float", "unquantized_integer", "fixed_point", "symmetric", "requant_params"]},
            "contract": {"type": "string", "minLength": 1},
            "parameter_generation": {"enum": ["offline_float", "online_integer", "static_constants", "not_applicable"]},
            "rounding": {"enum": ["ties_to_even", "floor", "not_applicable"]},
            "saturation": {"enum": ["clip", "reject", "not_applicable"]},
            "fraction_bits": {"type": "integer", "minimum": 0, "maximum": 63},
            "zero_point": {"const": 0},
            "group_axes": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
            "group_shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
            "scale_tensor": {"type": "string", "minLength": 1},
            "scale_encoding": {"enum": ["descriptive_f32", "dyadic_exponent_i16"]},
            "multiplier_tensor": {"type": "string", "minLength": 1},
            "shift_tensor": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
