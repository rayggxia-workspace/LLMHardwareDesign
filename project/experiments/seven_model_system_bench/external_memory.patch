+// A pointer for derived operands, or a byte-addressed view of the checkpoint.
+struct WeightView {
+  const int16_t *local = nullptr;
+  Offchip *memory = nullptr;
+  uint64_t byte_offset = 0;
+  WeightView(const int16_t *ptr = nullptr) : local(ptr) {}
+  WeightView(Offchip &port, uint64_t offset) : memory(&port), byte_offset(offset) {}
+  explicit operator bool() const { return local || memory; }
+  WeightView operator+(size_t elements) const {
+    return memory ? WeightView(*memory, byte_offset + elements * sizeof(int16_t))
+                  : WeightView(local + elements);
+  }
+  void fetch(int16_t *destination, size_t count) const {
+    if (memory)
+      memory->read(MemoryKind::Weight, byte_offset, destination, count * sizeof(int16_t));
+    else
+      std::copy_n(local, count, destination);
+  }
+};
