HELP=replace_cell
replace_cell instance lib_cell 
  The replace_cell command changes the cell of an instance. The replacement
  cell must have the same port list (number, name, and order) as the instance's
  existing cell for the replacement to be successful.

  set cell [get_lib_cell_warn "lib_cell" $lib_cell]
  if { $cell != "NULL" } {
    set inst [get_instance_error "instance" $instance]
    set inst_cell [$inst liberty_cell]
    if { $inst_cell == "NULL"  || ![equiv_cell_ports $inst_cell $cell] } {
      return 0
    }
    replace_cell_cmd $inst $cell
    return 1
  } else {
    return 0
  }

