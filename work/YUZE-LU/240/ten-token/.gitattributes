# Preserve original bytes for SHA receipts, including legitimate Windows CRLF.
# Keep normal trailing-space/blank-at-EOF/space-before-tab checks enabled.
evidence/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
