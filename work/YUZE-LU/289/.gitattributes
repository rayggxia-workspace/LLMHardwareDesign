# Preserve hash-bound HDL and evidence bytes on Windows checkouts.
*.sv -text
*.json -text
*.rpt -text
*.log -text
*.tsv -text
*.lef -text
audit/evidence/** -text
gs/evidence/** -text

# Executable experiment scripts must remain usable on the Linux server.
*.sh text eol=lf
*.sbatch text eol=lf
*.tcl text eol=lf
*.py text eol=lf
*.ys text eol=lf
