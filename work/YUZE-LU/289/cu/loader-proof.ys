read_verilog -sv loader-original.sv
hierarchy -top e32_tiled_dot_loader
proc
memory_map
opt_clean
rename e32_tiled_dot_loader gold
design -stash gold
read_verilog -sv loader-parallel.sv
hierarchy -top e32_tiled_dot_loader
proc
memory_map
opt_clean
rename e32_tiled_dot_loader gate
design -stash gate
design -copy-from gold gold
design -copy-from gate gate
equiv_make gold gate equiv
hierarchy -top equiv
equiv_simple
equiv_induct -seq 2
equiv_status -assert
