set_cmd_units -time ns -capacitance fF -resistance kOhm -distance um
set_units -time ns -capacitance fF -resistance kOhm -distance um
create_clock -name core -period 3.3333333333333335 [get_ports core_clk]
create_clock -name mem -period 2.0 [get_ports mem_clk]
set_clock_uncertainty 0.1 [all_clocks]
set_clock_transition 0.05 [all_clocks]
set_input_delay -clock core -max 0.8 [get_ports [list {cmd_data*} {cmd_index*} {cmd_op*} {cmd_valid} {done_ready} {load_a_base*} {load_a_wide} {load_b_base*} {load_b_wide} {load_bank} {load_rows*} {load_tiles*} {load_valid} {rsp_ready}]]
set_input_delay -clock core -min 0.2 [get_ports [list {cmd_data*} {cmd_index*} {cmd_op*} {cmd_valid} {done_ready} {load_a_base*} {load_a_wide} {load_b_base*} {load_b_wide} {load_bank} {load_rows*} {load_tiles*} {load_valid} {rsp_ready}]]
set_output_delay -clock core -max 0.8 [get_ports [list {busy} {cmd_ready} {done_error} {done_valid} {load_ready} {loading} {request_fifo_full} {rsp_data*} {rsp_error} {rsp_saturated} {rsp_valid}]]
set_output_delay -clock core -min 0.2 [get_ports [list {busy} {cmd_ready} {done_error} {done_valid} {load_ready} {loading} {request_fifo_full} {rsp_data*} {rsp_error} {rsp_saturated} {rsp_valid}]]
set_input_delay -clock mem -max 0.4 [get_ports [list {mem_req_ready} {mem_rsp_data*} {mem_rsp_error} {mem_rsp_valid}]]
set_input_delay -clock mem -min 0.1 [get_ports [list {mem_req_ready} {mem_rsp_data*} {mem_rsp_error} {mem_rsp_valid}]]
set_output_delay -clock mem -max 0.4 [get_ports [list {mem_req_address*} {mem_req_valid} {mem_rsp_ready} {response_fifo_full}]]
set_output_delay -clock mem -min 0.1 [get_ports [list {mem_req_address*} {mem_req_valid} {mem_rsp_ready} {response_fifo_full}]]
set_input_delay -clock core -max 0.8 [get_ports reset]
set_input_delay -clock core -min 0.2 [get_ports reset]
set di [get_ports [list {cmd_data*} {cmd_index*} {cmd_op*} {cmd_valid} {done_ready} {load_a_base*} {load_a_wide} {load_b_base*} {load_b_wide} {load_bank} {load_rows*} {load_tiles*} {load_valid} {mem_req_ready} {mem_rsp_data*} {mem_rsp_error} {mem_rsp_valid} {reset} {rsp_ready}]]
set_driving_cell -lib_cell BUF_X2 -pin Z $di
set_load 50 [all_outputs]
set_max_delay -ignore_clock_latency 2.0 -from [get_clocks core] -to [get_clocks mem]
set_min_delay -ignore_clock_latency 0.0 -from [get_clocks core] -to [get_clocks mem]
set_max_delay -ignore_clock_latency 2.0 -from [get_clocks mem] -to [get_clocks core]
set_min_delay -ignore_clock_latency 0.0 -from [get_clocks mem] -to [get_clocks core]
set_false_path -from [get_ports reset] -to [get_pins [list {$auto$ff.cc:337:slice$484047/SN} {$auto$ff.cc:337:slice$484938/SN} {$auto$ff.cc:337:slice$493651/SN} {$auto$ff.cc:337:slice$504355/SN}]]
