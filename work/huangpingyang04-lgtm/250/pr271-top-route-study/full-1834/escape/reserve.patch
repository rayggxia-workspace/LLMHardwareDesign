+vector<Route> reserve_ports(const vector<Net>& nets, Occupancy& occupied, TrackGraph& graph,
+                            vector<Access>& reserved, vector<pair<size_t,size_t>>& ranges,
+                            int threshold, size_t& count) {
+    vector<Route> result(nets.size());
+    if (threshold <= 0) return result;
+    constexpr int radius = 4*pitch;
+    struct Item { int density, net, pin; };
+    unordered_map<int,vector<pair<int,Node>>> bins;
+    auto cell = [](int x,int y) { return x*5000+y; };
+    for (const auto& net:nets)
+        for(auto p:net.pins) bins[cell(p.x/radius,p.y/radius)].push_back({net.id,p});
+    vector<Item> order;
+    for(const auto& net:nets) {
+        reserved[net.id].resize(net.pins.size());
+        for(size_t pin=0;pin<net.pins.size();++pin) {
+            auto p=net.pins[pin];
+            int density=0;
+            for(int x=max(0,p.x/radius-1);x<=p.x/radius+1;++x)
+                for(int y=max(0,p.y/radius-1);y<=p.y/radius+1;++y) {
+                    auto it=bins.find(cell(x,y));
+                    if(it==bins.end()) continue;
+                    for(auto [owner,q]:it->second)
+                        if(owner!=net.id && abs(p.x-q.x)<=radius && abs(p.y-q.y)<=radius) ++density;
+                }
+            if(density>=threshold) order.push_back({density,net.id,int(pin)});
+        }
+    }
+    stable_sort(order.begin(),order.end(),[](Item a,Item b) {return a.density>b.density;});
+    // Reservation shapes live in a separate occupancy during the pin-level allocation.
+    Occupancy trial=occupied;
+    for(auto entry:order) {
+        const auto& net=nets[entry.net];
+        auto& owned=result[entry.net];
+        const auto pin=net.pins[entry.pin];
+        const auto peer=net.pins[entry.pin==0?1:0];
+        auto paths=portals(pin,net,trial,owned.vias,numeric_limits<int>::max());
+        vector<Node> chosen;
+        int best=numeric_limits<int>::max();
+        for(const auto& path:paths) {
+            auto tip=path.back();
+            const auto used=cuts(path);
+            for(int layer:{tip.layer,1-tip.layer}) {
+                auto start=tip;
+                start.layer=layer;
+                if(layer!=tip.layer) {
+                    if(trial.blocked(net.id,tip,start)!=-1 ||
+                       !vias_fit(used,{start}) || !vias_fit(owned.vias,{start})) continue;
+                }
+                for(int d:{-pitch,pitch}) {
+                    auto end=start;
+                    (layer?end.y:end.x)+=d;
+                    if(!trial.fits(end) || trial.blocked(net.id,start,end)!=-1) continue;
+                    const int score=int(access_cost(path)/cost_scale)+
+                                    md(end,peer)-md(pin,peer)+(layer!=tip.layer?28:0);
+                    if(score>=best) continue;
+                    chosen=path;
+                    if(layer!=tip.layer) chosen.push_back(start);
+                    chosen.push_back(end);
+                    best=score;
+                }
+            }
+        }
+        if (chosen.empty()) continue;
+        Route stub;
+        append_path(stub,net,chosen);
+        trial.add_route(net.id,stub);
+        owned.wires.insert(owned.wires.end(),stub.wires.begin(),stub.wires.end());
+        owned.vias.insert(owned.vias.end(),stub.vias.begin(),stub.vias.end());
+        reserved[net.id][entry.pin]=move(chosen);
+        ++count;
+    }
+    for (const auto& net:nets) {
+        ranges[net.id].first=occupied.shapes.size();
+        occupied.add_route(net.id,result[net.id]);
+        ranges[net.id].second=occupied.shapes.size();
+        graph.occupy(result[net.id]);
+    }
+    cerr<<"reserved "<<count<<" examined "<<order.size()<<" threshold "<<threshold<<'\n';
+    return result;
+}
